{
  "name": "personal-website",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "seo:build": "python3 scripts/build_en_pages.py && python3 scripts/build_sitemap.py",
